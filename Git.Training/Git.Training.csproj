<Project Sdk="Microsoft.NET.Sdk.Web">
	<PropertyGroup>
		<TargetFramework>net8.0</TargetFramework>
		<Description>API Web Service</Description>
		<RootNamespace>Git.Training</RootNamespace>
		<AssemblyName>Git.Training</AssemblyName>
		<StartupObject></StartupObject>
	</PropertyGroup>
  
	<PropertyGroup>
		<GenerateDocumentationFile>true</GenerateDocumentationFile>
		<NoWarn>$(NoWarn);1591</NoWarn>
		<ApplicationInsightsResourceId>/subscriptions/ec1f2ce1-0089-4251-868d-b84f2c1d8318/resourcegroups/API-Zoom-RG/providers/microsoft.insights/components/apins-zoom-dev</ApplicationInsightsResourceId>
		<GeneratePackageOnBuild>true</GeneratePackageOnBuild>
	</PropertyGroup>

	<PropertyGroup Condition="'$(Configuration)|$(Platform)'=='Debug|AnyCPU'">
		<GenerateSerializationAssemblies>Off</GenerateSerializationAssemblies>
	</PropertyGroup>

	<ItemGroup>
		<PackageReference Include="Binus.WS.Pattern" Version="4.0.0" />
		<PackageReference Include="Binus.WS.Pattern.Redis" Version="4.0.2" />
		<PackageReference Include="Binus.WS.Pattern.Entities" Version="4.0.2" />
		<PackageReference Include="Microsoft.ApplicationInsights.AspNetCore" Version="2.23.0" />
		<PackageReference Include="Swashbuckle.AspNetCore" Version="8.1.4" />
	</ItemGroup>
	<ItemGroup>
		<WCFMetadata Include="Connected Services" />
	</ItemGroup>
</Project>